generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role{
  ROOT
  ADMIN
  OWNER
  CASHIER
  CHEF
  RECEPTIONIST
  WAITRESS
}

enum OderStatus{
  PENDDING
  READY
  DONE
  COOKING
}

model Restaurants{
  id Int @id @default(autoincrement())
  name String

  users Users[]
  branches Branches[]
  categories Categories[]
  dishes Dishes[]
}

model Users{
  id Int @id @default(autoincrement())
  name String
  role Role
  email String @unique
  password String
  restaurant_id Int

  // tiene un ? porque puede haber un usuario que todavia no es employee
  Employee Employees?
  Restaurant Restaurants @relation(fields: [restaurant_id], references: [id])
}

model Branches{
  id Int @id @default(autoincrement())
  name String
  address String
  city String
  country String
  tables Int
  restaurant_id Int

  Orders Orders[]
  branch_dishes Branch_dishes[]
  Employees Employees[]
  Tables Tables[]
  Reservations Reservations[]
  Schedule Schedule?

  Restaurant Restaurants @relation(fields: [restaurant_id], references: [id])
}

model Tables {
  id Int @id @default(autoincrement())
  capacity Int
  branch_id Int

  Reservations Reservations[]

  Banch Branches @relation(fields: [branch_id], references: [id])
}

model Schedule {
  id           Int @id @default(autoincrement())
  branch_id    Int @unique
  opening_time String
  closing_time String
  interval     Int

  branch Branches @relation(fields: [branch_id], references: [id])
}

model Employees {
  id Int @id @default(autoincrement())
  // unique hace que la relacion sea 1 a 1
  userId Int @unique
  branchId Int

  User Users @relation(fields: [userId], references: [id])
  Branch Branches @relation(fields: [branchId], references: [id])
}

model Categories{
  id Int @id @default(autoincrement())
  name String

  restaurant_id Int

  Dishes Dishes[]

  Restaurant Restaurants @relation(fields: [restaurant_id], references: [id])
}

model Dishes{
  id Int @id @default(autoincrement())
  name String
  image_url String
  image_id String
  category_id Int
  restaurant_id Int

  Branch_Dishes Branch_dishes[]

  Category Categories @relation(fields: [category_id], references: [id])
  Restaurant Restaurants @relation(fields: [restaurant_id], references: [id])
}

model Branch_dishes{
  id Int @id @default(autoincrement())
  branch_id Int
  dish_id Int
  price Decimal
  name String

  Dish Dishes @relation(fields: [dish_id], references: [id])
  Branch Branches @relation(fields: [branch_id], references: [id])

  @@unique([dish_id, branch_id])
}

model Orders{
  id Int @id @default(autoincrement())
  total Decimal
  status OderStatus
  date DateTime @default(now())
  branch_id Int
  user_id Int

  Branch Branches @relation(fields: [branch_id], references: [id])
  Order_dish Order_dish[]
}

model Order_dish{
  id Int @id @default(autoincrement())
  branch_dish_id Int // id del dish de una branch especifica
  order_id Int
  quantity Int
  subtotal Decimal
  name String
  
  Order Orders @relation(fields: [order_id], references: [id])
}

model Reservations {
  id Int @id @default (autoincrement())
  branch_id Int
  table_id Int
  name String
  phone String
  people Int
  date DateTime
  status String

  Table Tables @relation(fields: [table_id], references: [id])
  Branch Branches @relation(fields: [branch_id], references: [id])
}