generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ROOT
  ADMIN
  OWNER
  CASHIER
  CHEF
  RECEPTIONIST
  WAITRESS
}

enum OrderStatus {
  PENDING
  READY
  DONE
  COOKING
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Restaurants {
  id         Int          @id @default(autoincrement())
  name       String
  Users      Users[]
  Branches   Branches[]
  Categories Categories[]
  Dishes     Dishes[]
}

model Users {
  id            Int        @id @default(autoincrement())
  name          String
  role          Role
  email         String     @unique
  password      String
  restaurant_id Int
  branch_id     Int?

  Employee   Employees?
  Branch     Branches?   @relation(fields: [branch_id], references: [id])
  Restaurant Restaurants @relation(fields: [restaurant_id], references: [id])
  Orders     Orders[]

  @@index([restaurant_id])
  @@index([branch_id])
}

model Branches {
  id            Int      @id @default(autoincrement())
  name          String
  address       String
  city          String
  country       String
  restaurant_id Int

  Orders        Orders[]
  branch_dishes Branch_dishes[]
  Tables        Tables[]
  Reservations  Reservations[]
  Users         Users[]
  Schedule      Schedule?

  Restaurant Restaurants @relation(fields: [restaurant_id], references: [id])

  @@index([restaurant_id])

}

model Tables {
  id           Int            @id @default(autoincrement())
  capacity     Int
  branch_id    Int
  Reservations Reservations[]

  Branch Branches @relation(fields: [branch_id], references: [id])
}

model Schedule {
  id           Int      @id @default(autoincrement())
  branch_id    Int      @unique
  opening_time String
  closing_time String
  interval     Int

  Branch Branches @relation(fields: [branch_id], references: [id])
}

model Employees {
  id       Int      @id @default(autoincrement())
  userId   Int      @unique
  salary   Decimal
  hireDate DateTime

  User Users @relation(fields: [userId], references: [id])
}

model Categories {
  id            Int    @id @default(autoincrement())
  name          String
  restaurant_id Int

  Dishes     Dishes[]
  Restaurant Restaurants @relation(fields: [restaurant_id], references: [id])
}

model Dishes {
  id             Int    @id @default(autoincrement())
  name           String
  image_url      String
  image_id       String
  category_id    Int
  restaurant_id  Int

  Branch_Dishes Branch_dishes[]
  Category      Categories      @relation(fields: [category_id], references: [id])
  Restaurant    Restaurants     @relation(fields: [restaurant_id], references: [id])
}

model Branch_dishes {
  id        Int      @id @default(autoincrement())
  branch_id Int
  dish_id   Int
  price     Decimal
  name      String

  Dish       Dishes       @relation(fields: [dish_id], references: [id])
  Branch     Branches     @relation(fields: [branch_id], references: [id])
  Order_dish Order_dish[]

  @@unique([dish_id, branch_id])
}

model Orders {
  id         Int         @id @default(autoincrement())
  total      Decimal
  status     OrderStatus
  date       DateTime    @default(now())
  branch_id  Int
  user_id    Int

  Branch     Branches     @relation(fields: [branch_id], references: [id])
  User       Users        @relation(fields: [user_id], references: [id])
  Order_dish Order_dish[]
}

model Order_dish {
  id             Int      @id @default(autoincrement())
  branch_dish_id Int
  order_id       Int
  quantity       Int
  subtotal       Decimal
  name           String

  Branch_dish Branch_dishes @relation(fields: [branch_dish_id], references: [id])
  Order       Orders        @relation(fields: [order_id], references: [id])
}

model Reservations {
  id        Int               @id @default(autoincrement())
  branch_id Int
  table_id  Int
  name      String
  phone     String
  people    Int
  date      DateTime
  status    ReservationStatus

  Table  Tables   @relation(fields: [table_id], references: [id])
  Branch Branches @relation(fields: [branch_id], references: [id])
}